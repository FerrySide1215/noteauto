      "captions": [
        {
          "start": 0.0,
          "end": 3.4,
          "text": "六か所の言葉を、並べてみます。",
          "red": []
        },
        {
          "start": 3.4,
          "end": 7.12,
          "text": "金劔宮は、小さなところを、丁寧に。",
          "red": []
        },
        {
          "start": 7.12,
          "end": 11.32,
          "text": "白山比咩神社は、自分を省み、言葉を慎む。",
          "red": []
        },
        {
          "start": 11.32,
          "end": 15.19,
          "text": "服部神社は、今いる場所で、根を張る。",
          "red": []
        },
        {
          "start": 15.19,
          "end": 20.51,
          "text": "ここまでが、一日目。止まって、足元を整える流れでした。",
          "red": []
        },
        {
          "start": 20.51,
          "end": 23.59,
          "text": "那谷寺は、急がず、育てる。",
          "red": []
        },
        {
          "start": 23.59,
          "end": 26.83,
          "text": "菟橋神社は、見極めて、選ぶ。",
          "red": []
        },
        {
          "start": 26.83,
          "end": 30.55,
          "text": "安宅住吉神社は、あらためて、進む。",
          "red": []
        },
        {
          "start": 30.55,
          "end": 35.07,
          "text": "二日目は、見極めて、必要な部分を直して進む。",
          "red": []
        },
        {
          "start": 35.07,
          "end": 39.11,
          "text": "最初と最後で、言葉は少し変わりました。",
          "red": []
        },
        {
          "start": 39.11,
          "end": 42.18,
          "text": "でも、矛盾はしていません。",
          "red": []
        },
        {
          "start": 42.18,
          "end": 45.42,
          "text": "方向転換ではなく、軌道修正。",
          "red": []
        },
        {
          "start": 45.42,
          "end": 50.42,
          "text": "今回の旅を振り返った時、私は、そう受け取りました。",
          "red": []
        }
      ],
      "cards": [
        {
          "start": 27.73,
          "end": 49.91,
