          "text": "旅の最後は、安宅住吉神社（あたかすみよしじんじゃ）。",
          "red": []
        },
        {
          "start": 5.04,
          "end": 9.3,
          "text": "難関を突破する神様として、知られています。",
          "red": []
        },
        {
          "start": 9.3,
          "end": 11.55,
          "text": "おみくじは、吉。",
          "red": []
        },
        {
          "start": 11.55,
          "end": 15.19,
          "text": "時期を見て、あらためて進むとよい。",
          "red": [
            "あらため"
          ]
        },
        {
          "start": 15.19,
          "end": 18.84,
          "text": "人と力を合わせれば、よい道がある。",
          "red": []
        },
        {
          "start": 18.84,
          "end": 23.57,
          "text": "でも、悪いと分かっている道を、進んではいけない。",
          "red": []
        },
        {
          "start": 23.57,
          "end": 28.14,
          "text": "ここまでの言葉が、ひとつに、つながり始めます。",
          "red": []
        }
      ],
      "cards": [
        {
          "start": 0.5,
          "end": 4.0,
          "lines": [
            {
              "text": "安宅住吉神社（あたかすみよし）",
              "style": "location",
              "dy": 380
            },
            {
              "text": "石川県",
              "style": "location",
              "dy": 430
            }
          ]
        },
        {
          "start": 7.879200000000001,
          "end": 10.4792,
          "lines": [
            {
              "text": "第四十番　吉",
              "style": "onscreen",
              "dy": 0
            }
          ]
        },
        {
          "start": 12.66,
          "end": 16.91,
          "lines": [
            {
              "text": "時期を考えてはやくあらため進むがよい",
              "style": "onscreen",
              "red": [
                "時期を考えて",
                "あらため"
              ],
              "dy": 300
            }
          ]
        },
        {
          "start": 16.41,
          "end": 20.67,
          "lines": [
            {
              "text": "人と人と互に力あわせてすればよきみちあり",
              "style": "onscreen",
              "red": [
                "力あわせて"
              ],
              "dy": 300
            }
          ]
        },
        {
          "start": 20.17,
          "end": 24.42,
          "lines": [
            {
              "text": "けれどわるいみちと知りつつ進めばわるし",
              "style": "onscreen",
              "red": [
                "わるいみちと知りつつ"
              ],
              "dy": 300
            }
          ]
        },
        {
          "start": 15.48,
          "end": 28.14,
          "lines": [
            {
              "text": "あらためて、進む",
              "style": "vtext",
              "vertical": true,
              "dy": 0
            }
          ]
        }
      ],
      "nat_sound_break": false
