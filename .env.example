# setup-notion.mjs および wrangler secret 登録用のローカル変数
# 本物の値は絶対にコミットしない（.gitignore で除外済み）

# LINE Developers Console から取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Notion integration（https://www.notion.so/profile/integrations）で作成
NOTION_TOKEN=

# 勤怠用 Notion ワークスペース内の "親ページ" ID
# このページ配下に 4 つの DB が自動生成される
NOTION_PARENT_PAGE_ID=

# setup-notion.mjs 実行後に出力される DB ID をここに転記
NOTION_DB_STAFF=
NOTION_DB_PUNCH=
NOTION_DB_WORKLOG=
NOTION_DB_REPORT=

# 管理者（ODB等）の LINE userId。カンマ区切り。日報や打刻忘れ通知の宛先
ADMIN_LINE_USER_IDS=

# タイムゾーン（JST = 540 分）
TZ_OFFSET_MIN=540
